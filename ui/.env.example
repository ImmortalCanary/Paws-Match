# Verbindung zur Paws-&-Match-Datenbank.
# Diese Datei kopieren nach ui/.env und an die eigene MySQL-Installation anpassen.
#
# Standardwerte passen zum portablen Testserver aus context/AGENTS.md (Abschnitt 7).
# Fuer eine normale MySQL-Installation (MySQL Workbench) meist Port 3306 und ein Passwort.

PAWS_DB_HOST=127.0.0.1
PAWS_DB_PORT=3399
PAWS_DB_USER=root
PAWS_DB_PASSWORD=
PAWS_DB_NAME=paws_match
